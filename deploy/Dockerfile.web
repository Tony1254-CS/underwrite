FROM node:20-bookworm-slim AS builder

ENV NEXT_TELEMETRY_DISABLED=1
WORKDIR /workspace

RUN npm install -g pnpm@12.8.1

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY engine/package.json ./engine/package.json
COPY web/package.json ./web/package.json
RUN pnpm install --frozen-lockfile --filter web...

COPY web ./web
RUN pnpm --filter web build

FROM node:20-bookworm-slim AS runner

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    HOSTNAME=0.0.0.0 \
    PORT=3000 \
    CHAIN=base-sepolia \
    RPC_URL=https://sepolia.base.org
WORKDIR /workspace

COPY --from=builder --chown=node:node /workspace/package.json /workspace/pnpm-lock.yaml /workspace/pnpm-workspace.yaml /workspace/.npmrc ./
COPY --from=builder --chown=node:node /workspace/node_modules ./node_modules
COPY --from=builder --chown=node:node /workspace/web/package.json ./web/package.json
COPY --from=builder --chown=node:node /workspace/web/node_modules ./web/node_modules
COPY --from=builder --chown=node:node /workspace/web/next.config.mjs ./web/next.config.mjs
COPY --from=builder --chown=node:node /workspace/web/.next ./web/.next
COPY --from=builder --chown=node:node /workspace/web/public ./web/public

USER node
EXPOSE 3000
HEALTHCHECK --interval=20s --timeout=5s --start-period=20s --retries=3 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:3000/').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"]

CMD ["node", "web/node_modules/next/dist/bin/next", "start", "web", "--hostname", "0.0.0.0", "--port", "3000"]
